  "description": "Opshell's blog",
  "main": "index.js",
  "repository": "https://github.com/Opshell/opshell.github.io.git",
  "packageManager": "pnpm@10.28.2",
  "author": "Opshell",
  "license": "MIT",
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@types/fs-extra": "11.0.4",
    "@types/markdown-it-container": "2.0.10",
    "@types/three": "^0.182.0",
    "eslint": "10.11.0",
    "globby": "16.0.0",
    "gray-matter": "4.0.3",
    "markdown-it-container": "^4.0.0",
    "medium-zoom": "1.1.0",
    "postcss": "8.5.6",
    "postcss-html": "2.0.0",
    "postcss-scss": "4.0.9",
    "sass": "1.94.2",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-config-standard-vue": "2.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "5.9.3",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite-plugin-svg-icons": "2.0.1",
    "vitepress": "1.3.2",
    "vitepress-plugin-sandpack": "1.1.4",
    "vue-tsc": "^3.3.11"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check": "pnpm lint && pnpm lint:style && pnpm typecheck && pnpm docs:build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint 'docs/**/*.{scss,vue}'",
    "lint:style:fix": "stylelint 'docs/**/*.{scss,vue}' --fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "new-post": "node scripts/new-post.js",
    "add-frontmatter": "node scripts/add-frontmatter.mjs",
    "fix-tags": "node scripts/fix-tags.mjs",
    "fix-empty-frontmatter": "node scripts/fix-empty-categories-tags.mjs",
    "fix-createdAt": "node scripts/fix-createdAt-format.mjs",
    "gallery-thumb": "node scripts/generate-gallery.mjs",
    "dindon:privacy": "node scripts/sync-dindon-privacy.mjs"
  },
  "dependencies": {
    "@giscus/vue": "3.1.1",
    "@tresjs/cientos": "5.3.0",
